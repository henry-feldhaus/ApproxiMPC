   "source": [
    "#similarity analysis. \n",
    "\n",
    "#need a metric to determine how similar the raceline are to each other\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b2bae9ab",
   "metadata": {},
   "source": [
    "## Additional Analysis "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "be6744a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np
",
    "import pandas as pd
",
    "from pathlib import Path
",
    "
",
    "try:
",
    "    from scipy.spatial import cKDTree
",
    "    have_kdtree = True
",
    "except Exception:
",
    "    have_kdtree = False
",
    "
",
    "def load_track_points(filepath):
",
    "    with np.load(filepath, allow_pickle=True) as data:
",
    "        if 'x' in data.files and 'y' in data.files:
",
    "            xs = data['x']
",
    "            ys = data['y']
",
    "        elif 'observations' in data.files:
",
    "            obs = data['observations']
",
    "            xs = obs[:, 0]
",
    "            ys = obs[:, 1]
",
    "        else:
",
    "            raise KeyError('No x/y or observations found in file: ' + str(filepath))
",
    "    return np.column_stack([xs, ys])
",
    "
",
    "def trajectory_similarity(mpc_path, lstm_path):
",
    "    mpc_pts = load_track_points(mpc_path)
",
    "    lstm_pts = load_track_points(lstm_path)
",
    "    if have_kdtree:
",
    "        tree = cKDTree(mpc_pts)
",
    "        d, _ = tree.query(lstm_pts, k=1)
",
    "    else:
",
    "        d = np.empty(len(lstm_pts), dtype=np.float64)
",
    "        chunk = 1024
",
    "        for start in range(0, len(lstm_pts), chunk):
",
    "            block = lstm_pts[start:start + chunk]  # shape (chunk, 2)
",
    "            diff = mpc_pts[None, :, :] - block[:, None, :]
",
    "            d[start:start + chunk] = np.min(np.linalg.norm(diff, axis=2), axis=1)
",
    "    return {
",
    "        'mean_error': float(np.mean(d)),
",
    "        'max_error': float(np.max(d)),
",
    "        'sum_error': float(np.sum(d)),
",
    "        'last_error': float(d[-1]) if len(d) > 0 else float('nan'),
",
    "    }
",
    "
",
    "map_map = {
",
    "    'ims': 'ims',
",
    "    'drift2': 'drift2',
",
    "    'brandhatch': 'brandshatch',
",
    "    'mexico city': 'mexicocity',
",
    "    'spielberg': 'spielberg',
",
    "}
",
    "
",
    "def mpc_baseline_path(map_name):
",
    "    target = map_map.get(map_name.lower(), map_name.lower())
",
    "    candidates = df_experiments[(df_experiments['algorithm'] == 'MPC') & (df_experiments['map'] == target)]
",
    "    if len(candidates) == 0:
",
    "        return None
",
    "    return candidates.iloc[0]['filepath']
",
    "
",
    "similarity_rows = []
",
    "successful_curvature = df_experiments[(df_experiments['algorithm'] == 'LSTM') & (df_experiments['model_type'] == 'curvature') & (df_experiments['status'] == 'Success')]
",
    "for _, row in successful_curvature.iterrows():
",
    "    mpc_path = mpc_baseline_path(row['map'])
",
    "    if mpc_path is None:
",
    "        continue
",
    "    metrics = trajectory_similarity(mpc_path, row['filepath'])
",
    "    similarity_rows.append({
",
    "        'map': row['map'],
",
    "        'model': f"{row['model_type']} {int(row['size']) if not pd.isna(row['size']) else 'NA'}",
",
    "        'lap_time': row['lap_time'],
",
    "        'mean_error': metrics['mean_error'],
",
    "        'max_error': metrics['max_error'],
",
    "        'sum_error': metrics['sum_error'],
",
    "        'last_error': metrics['last_error'],
",
    "    })
",
    "
",
    "similarity_df = pd.DataFrame(similarity_rows).sort_values(['map', 'mean_error'])
",
    "print('=== Trajectory similarity metrics: LSTM vs MPC (curvature only) ===')
",
    "display(similarity_df)
"
   ]
  },

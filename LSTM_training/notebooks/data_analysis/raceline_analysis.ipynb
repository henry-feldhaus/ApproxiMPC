   "source": [
    "from math import hypot\n",
    "\n",
    "# Validate that 'completion_flag' represents a lap ending near the start/goal.\n",
    "def summarize_lstm_completion(filepath):\n",
    "    try:\n",
    "        with np.load(filepath, allow_pickle=True) as data:\n",
    "            ts = data[get_actual_key(data, 'timestamps')]\n",
    "            x = data[get_actual_key(data, 'x')]\n",
    "            y = data[get_actual_key(data, 'y')]\n",
    "            left_start = data[get_actual_key(data, 'has_left_start_zone')]\n",
    "            completed = data[get_actual_key(data, 'completion_flag')]\n",
    "            d2s = data[get_actual_key(data, 'distance_to_start')]\n",
    "            d2g = data[get_actual_key(data, 'distance_to_goal')]\n",
    "\n",
    "            start_idx = int(np.argmax(left_start == 1)) if np.any(left_start == 1) else 0\n",
    "            completion_idx = int(np.argmax(completed == 1)) if np.any(completed == 1) else None\n",
    "            initial_pos = (float(x[0]), float(y[0]))\n",
    "            start_pos = (float(x[start_idx]), float(y[start_idx]))\n",
    "            final_pos = (float(x[-1]), float(y[-1]))\n",
    "\n",
    "            result = {\n",
    "                'filepath': filepath.name,\n",
    "                'start_idx': start_idx,\n",
    "                'completion_idx': completion_idx,\n",
    "                'start_time': float(ts[start_idx]),\n",
    "                'final_time': float(ts[-1]),\n",
    "                'final_distance_to_start': float(d2s[-1]),\n",
    "                'final_distance_to_goal': float(d2g[-1]),\n",
    "                'completion_flag': bool(np.any(completed == 1)),\n",
    "                'has_left_start_zone': bool(np.any(left_start == 1)),\n",
    "                'initial_distance_to_start': float(d2s[0]),\n",
    "                'initial_pos_x': float(initial_pos[0]),\n",
    "                'initial_pos_y': float(initial_pos[1]),\n",
    "                'error': None,\n",
    "            }\n",
    "\n",
    "            if completion_idx is not None:\n",
    "                completion_pos = (float(x[completion_idx]), float(y[completion_idx]))\n",
    "                result['completion_time'] = float(ts[completion_idx])\n",
    "                result['lap_time'] = float(ts[completion_idx] - ts[start_idx])\n",
    "                result['completion_distance_to_start'] = hypot(completion_pos[0] - initial_pos[0], completion_pos[1] - initial_pos[1])\n",
    "                result['completion_distance_to_goal'] = float(d2g[completion_idx])\n",
    "            else:\n",
    "                result['completion_time'] = np.nan\n",
    "                result['lap_time'] = np.nan\n",
    "                result['completion_distance_to_start'] = np.nan\n",
    "                result['completion_distance_to_goal'] = np.nan\n",
    "\n",
    "            return result\n",
    "    except Exception as e:\n",
    "        return {\n",
    "            'filepath': filepath.name,\n",
    "            'start_idx': None,\n",
    "            'completion_idx': None,\n",
    "            'start_time': np.nan,\n",
    "            'final_time': np.nan,\n",
    "            'final_distance_to_start': np.nan,\n",
    "            'final_distance_to_goal': np.nan,\n",
    "            'completion_flag': False,\n",
    "            'has_left_start_zone': False,\n",
    "            'completion_time': np.nan,\n",
    "            'lap_time': np.nan,\n",
    "            'completion_distance_to_start': np.nan,\n",
    "            'completion_distance_to_goal': np.nan,\n",
    "            'error': str(e),\n",
    "        }\n",
    "\n",
    "lstm_curvature = df_experiments[(df_experiments['algorithm'] == 'LSTM') & (df_experiments['model_type'] == 'curvature')].copy()\n",
    "summary_rows = []\n",
    "for _, row in lstm_curvature.iterrows():\n",
    "    summary_rows.append(summarize_lstm_completion(row['filepath']))\n",
    "df_lstm_completion = pd.DataFrame(summary_rows)\n",
    "\n",
    "# Mark whether the completion is plausibly a true lap return.\n",
    "df_lstm_completion['completion_valid'] = (\n",
    "    df_lstm_completion['completion_flag'] &\n",
    "    (df_lstm_completion['completion_distance_to_start'] <= 1.0) &\n",
    "    (df_lstm_completion['completion_distance_to_goal'] <= 1.0)\n",
    ")\n",
    "\n",
    "print('=== LSTM curvature completion validation ===')\n",
    "display(df_lstm_completion[['filepath', 'lap_time', 'completion_valid', 'completion_distance_to_start', 'final_distance_to_start', 'completion_distance_to_goal']])"
   ]
  },

    "# Create a robust map mapping dictionary\n",
    "# LSTM Directory Name -> MPC Filename Map Name\n",
    "map_map = {\n",
    "    'ims': 'ims',\n",
    "    'drift2': 'drift2',\n",
    "    'brandhatch': 'brandshatch', # Handling the 's' in the MPC file\n",
    "    'mexico city': 'mexicocity', # Handling the space\n",
    "    'spielberg': 'spielberg'\n",
    "}\n",
    "\n",
    "def get_mpc_row(lstm_map_name, df):\n",
    "    target = map_map.get(lstm_map_name.lower(), lstm_map_name.lower())\n",
    "    match = df[(df['algorithm'] == 'MPC') & (df['map'].str.lower() == target)]\n",
    "    return match.iloc[0] if not match.empty else None\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Filter and sort successful curvature LSTM runs\n",
    "successful_lstms = df_experiments[\n",
    "    (df_experiments['algorithm'] == 'LSTM') &\n",
    "    (df_experiments['model_type'] == 'curvature') &\n",
    "    (df_experiments['status'] == 'Success')\n",
    "].sort_values(['map', 'model_type', 'size'])\n",
    "unique_maps = sorted(successful_lstms['map'].unique())\n",
    "\n",
    "# 2. Determine grid dimensions\n",
    "max_models = successful_lstms.groupby('map').size().max()\n",
    "\n",
    "fig, axes = plt.subplots(len(unique_maps), max_models, figsize=(6 * max_models, 5 * len(unique_maps)))\n",
    "fig.suptitle('Comprehensive Model Performance: LSTM Trajectories vs. MPC Ground Truth', fontsize=24, fontweight='bold', y=1.03)\n",
    "\n",
    "for i, map_name in enumerate(unique_maps):\n",
    "    map_subset = successful_lstms[successful_lstms['map'] == map_name]\n",
    "    \n",
    "    # Use our mapping function to find the GT for this row\n",
    "    mpc_row = get_mpc_row(map_name, df_experiments)\n",
    "    \n",
    "    for j in range(max_models):\n",
    "        # Handle 1D or 2D axes array\n",
    "        ax = axes[i, j] if len(unique_maps) > 1 else axes[j]\n",
    "        \n",
    "        if j < len(map_subset):\n",
    "            row = map_subset.iloc[j]\n",
    "            \n",
    "            # --- 1. Plot MPC Ground Truth (Transparent Background) ---\n",
    "            if mpc_row is not None:\n",
    "                with np.load(mpc_row['filepath']) as mpc_data:\n",
    "                    obs = mpc_data['observations']\n",
    "                    # Increased alpha to 0.3 for better visibility in subplots\n",
    "                    ax.plot(obs[:, 0], obs[:, 1], color='black', alpha=0.3, linewidth=1.5, label='MPC GT', zorder=1)\n",
    "            \n",
    "            # --- 2. Plot LSTM Model ---\n",
    "            with np.load(row['filepath']) as lstm_data:\n",
    "                # Use a high-contrast color (Red or Blue)\n",
    "                ax.plot(lstm_data['x'], lstm_data['y'], color='#d62728', linewidth=1.5, label='LSTM', zorder=2)\n",
    "            \n",
    "            # --- 3. Labeling ---\n",
    "            model_name = row['filepath'].stem # Use filename as model name\n",
    "            model_label = (f\"Model: {model_name}\\n\"\n",
    "                           f\"Type: {row['model_type'].title()}\\n\"\n",
    "                           f\"Size: {int(row['size'])}\\n\"\n",
    "                           f\"Lap Time: {row['lap_time']:.2f}s\")\n",
    "            \n",
    "            ax.text(0.05, 0.05, model_label, transform=ax.transAxes, fontsize=10,\n",
    "                    verticalalignment='bottom', bbox=dict(boxstyle='round', facecolor='white', alpha=0.9))\n",
    "            \n",
    "            ax.set_title(f\"TRACK: {map_name.upper()}\", fontsize=14, fontweight='bold')\n",
    "            ax.axis('equal')\n",
    "            ax.set_xticks([]); ax.set_yticks([])\n",
    "            ax.grid(True, alpha=0.1)\n",
    "            \n",
    "            if j == 0:\n",
    "                ax.legend(loc='upper right', fontsize='small')\n",
    "        else:\n",
    "            # Hide empty subplots\n",
    "            ax.axis('off')\n",

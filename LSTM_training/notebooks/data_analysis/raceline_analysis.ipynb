   "source": [
    "# 3. Plotting\n",
    "ax = comparison_df[['MPC', 'LSTM']].plot(kind='bar', figsize=(12, 6), width=0.8, color=['#555555', '#1f77b4'])\n",
    "\n",
    "plt.title('Lap Time Comparison: MPC vs. Best LSTM', fontsize=14, pad=20)\n",
    "plt.ylabel('Lap Time (seconds)', fontsize=12)\n",
